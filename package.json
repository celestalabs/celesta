{
  "private": true,
  "name": "celesta",
  "type": "module",
  "version": "0.0.0",
  "description": "Monorepo for Celesta codebase",
  "homepage": "https://github.com/celestalabs/celesta#readme",
  "bugs": {
    "url": "https://github.com/celestalabs/celesta/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celestalabs/celesta.git"
  },
  "scripts": {
    "dev:extension": "cd packages/extension && npm run dev",
    "dev:integrations-api": "cd packages/integrations-api && npm run dev",
    "dev:workflow-agents": "cd packages/workflow-agents && npm run dev",
    "dev": "concurrently \"npm run dev:extension\" \"npm run dev:integrations-api\" \"npm run dev:workflow-agents\""
  },
  "workspaces": [
    "packages/extension",
    "packages/integrations-api",
    "packages/agent-server"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "wxt": "0.20.11",
    "@wxt-dev/browser": "0.1.4",
    "@wxt-dev/storage": "1.2.5"
  }
}
