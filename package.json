{
  "private": true,
  "name": "celesta",
  "type": "module",
  "version": "0.0.0",
  "description": "Monorepo for Celesta codebase",
  "homepage": "https://github.com/celestalabs/celesta#readme",
  "bugs": {
    "url": "https://github.com/celestalabs/celesta/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celestalabs/celesta.git"
  },
  "scripts": {
    "dev:extension": "cd packages/extension && npm run dev",
    "dev:server": "cd packages/server && npm run dev",
    "dev": "concurrently npm:dev:*",
    "format": "pretty-quick"
  },
  "workspaces": [
    "packages/extension",
    "packages/integrations",
    "packages/server",
    "packages/common",
    "packages/session",
    "packages/agents"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2"
  }
}
