{
  "private": true,
  "name": "celesta",
  "type": "module",
  "version": "0.0.0",
  "description": "Monorepo for Celesta codebase",
  "homepage": "https://github.com/celestalabs/celesta#readme",
  "bugs": {
    "url": "https://github.com/celestalabs/celesta/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celestalabs/celesta.git"
  },
  "scripts": {
    "dev:extension": "cd packages/extension && npm run dev",
    "dev:integrations-api": "cd packages/integrations-api && npm run dev",
    "dev": "concurrently \"npm run dev:extension\" \"npm run dev:integrations-api\""
  },
  "workspaces": [
    "packages/extension",
    "packages/integrations-api",
    "packages/playground"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
